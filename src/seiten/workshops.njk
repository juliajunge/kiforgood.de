---
title: Workshops - KI for Good - Trainings & Tools für KI in NGOS
description: Diese Workshops rund um KI in Vereinen und gemeinwohlorientierten Organisationen empfehlen wir. Von uns und anderen tollen Expert*innen.
permalink: /workshops/
bodyclass: wp-singular page-template-default page page-id-25 wp-custom-logo wp-embed-responsive wp-theme-twentytwentyfour
css: workshops
---
{#- Workshop-Seite mit festem Layout. Texte: inhalte/seiten/workshops.md, Termine: inhalte/termine.md -#}
{%- set a = seiten.workshops.abschnitte -%}
{%- set kopf = a[0] -%}{%- set anbieter = a[1] -%}{%- set liste = a[2] -%}{%- set danach = a[3] -%}{%- set drache = a[4] -%}
{%- set abstand = "margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)" -%}
<main id="wp--skip-link--target" class="wp-block-group is-layout-flow wp-block-group-is-layout-flow">
<div class="wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained">
<div style="height:var(--wp--preset--spacing--50)" aria-hidden="true" class="wp-block-spacer"></div>
<h1 class="has-text-align-center wp-block-post-title">{{ seiten.workshops.titel }}</h1>
<div style="margin-top:0;margin-bottom:0;height:var(--wp--preset--spacing--30)" aria-hidden="true" class="wp-block-spacer"></div>
</div>
<div class="entry-content wp-block-post-content has-global-padding is-layout-constrained wp-block-post-content-is-layout-constrained">

<div class="wp-block-group alignfull has-accent-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-73128380 wp-block-group-is-layout-constrained" style="{{ abstand }}">
<div class="wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-a0d91a25 wp-block-columns-is-layout-flex">
<div class="wp-block-column is-vertically-aligned-stretch is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:50%">
<div class="wp-block-group is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-c042bc37 wp-block-group-is-layout-flex" style="min-height:100%">
<p class="has-heading-font-family has-x-large-font-size wp-block-paragraph" style="line-height:1.2">{{ kopf.titelHtml | safe }}</p>
<div class="wp-block-group has-global-padding is-content-justification-left is-layout-constrained wp-container-core-group-is-layout-1292ae2f wp-block-group-is-layout-constrained">
{{ kopf.html | replace('<p class="wp-block-paragraph">', '<p class="wp-container-content-0733e5d0 wp-block-paragraph">') | safe }}
</div>
</div>
</div>
<div class="wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:50%">
{%- if kopf.bilder[0] %}
<figure class="wp-block-image size-full is-resized is-style-rounded ki-abgerundet"><img src="{{ kopf.bilder[0].src }}" alt="{{ kopf.bilder[0].alt }}" style="aspect-ratio:3/4;object-fit:cover;width:auto;height:500px" /></figure>
{%- endif %}
</div>
</div>
</div>

<div class="wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-ef10d34a wp-block-columns-is-layout-flex">
<div class="wp-block-column is-layout-flow wp-container-core-column-is-layout-0c22cdd7 wp-block-column-is-layout-flow" style="flex-basis:100%">
<h2 class="wp-block-heading">{{ anbieter.titelHtml | safe }}</h2>
{{ anbieter.html | safe }}
{%- for t in anbieter.teile %}
<div class="wp-block-media-text is-stacked-on-mobile is-vertically-aligned-top" style="grid-template-columns:20% auto">
<figure class="wp-block-media-text__media">{% if t.bilder[0] %}<img src="{{ t.bilder[0].src }}" alt="{{ t.bilder[0].alt }}" />{% endif %}</figure>
<div class="wp-block-media-text__content">
<p class="wp-block-paragraph"><strong>{{ t.titelHtml | safe }}</strong></p>
{{ t.html | safe }}
</div>
</div>
{%- endfor %}
{{ liste.html | safe }}
<p class="has-heading-font-family has-x-large-font-size wp-block-paragraph" style="line-height:1.2">{{ liste.titelHtml | safe }}</p>
{% include "partials/dauerangebote.njk" %}
</div>
</div>
<p class="wp-block-paragraph"></p>
{% include "partials/termine.njk" %}
<div class="wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow">
<hr class="wp-block-separator has-alpha-channel-opacity is-style-default"/>
<h2 class="wp-block-heading"><strong>{{ danach.titelHtml | safe }}</strong></h2>
<div style="height:28px" aria-hidden="true" class="wp-block-spacer"></div>
{{ danach.html | replace(' alignwide has-accent-4-background-color has-background">', ' has-accent-4-background-color has-background has-large-font-size">') | safe }}
<div style="height:48px" aria-hidden="true" class="wp-block-spacer"></div>
</div>

<div class="wp-block-group alignfull has-accent-5-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-36f65c2d wp-block-group-is-layout-constrained" style="{{ abstand }}">
<div class="wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-a0d91a25 wp-block-columns-is-layout-flex">
<div class="wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:60%">
{%- if drache.bilder[0] %}
<figure class="wp-block-image size-full is-style-rounded ki-abgerundet"><img src="{{ drache.bilder[0].src }}" alt="{{ drache.bilder[0].alt }}" style="aspect-ratio:4/3;object-fit:cover" /></figure>
{%- endif %}
</div>
<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:40%">
<h2 class="wp-block-heading">{{ drache.titelHtml | safe }}</h2>
{{ drache.html | safe }}
{{ drache.knoepfeHtml | safe }}
</div>
</div>
</div>
<div class="wp-block-group alignfull has-global-padding is-layout-constrained wp-container-core-group-is-layout-36f65c2d wp-block-group-is-layout-constrained" style="{{ abstand }}"></div>
</div>
</main>
