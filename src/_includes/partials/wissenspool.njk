{#- Favoriten und Bereiche der Seite /wissenspool/. Daten: src/_data/wissenspool.yaml -#}
{%- set spalten = "wp-block-columns is-layout-flex wp-container-core-columns-is-layout-3a88641f wp-block-columns-is-layout-flex" -%}
{%- set spalte = "wp-block-column is-layout-flow wp-block-column-is-layout-flow" -%}
{%- set bereich = "is-layout-constrained wp-container-core-group-is-layout-73128380 wp-block-group-is-layout-constrained" -%}
{%- set abstand = "margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)" -%}

{%- macro link(url, text) -%}
<a href="{{ url }}"{% if url | extern %} target="_blank" rel="noreferrer noopener"{% endif %}>{{ text }}</a>
{%- endmacro -%}

{%- macro eintrag(e) -%}
{% if e.titel -%}
<p class="wp-block-paragraph"><strong>{% if e.icon %}{{ e.icon }} {% endif %}{% if e.vor %}{{ e.vor }} {% endif %}{{ link(e.url, e.titel) }}{% if e.zusatz %} {{ e.zusatz | mdinline | safe }}{% endif %}<br></strong>{{ e.text | mdinline | safe }}</p>
{%- else -%}
<p class="wp-block-paragraph">{% if e.icon %}{{ e.icon }} {% endif %}{{ e.text | mdinline | safe }}</p>
{%- endif %}
{%- endmacro %}

<div class="{{ spalten }}">
{%- for favoriten in wissenspool.favoriten | spalten(3) %}
<div class="{{ spalte }}">
{%- for f in favoriten %}
<figure class="wp-block-image size-full">{% if f.bild_url %}<a href="{{ f.bild_url }}" target="_blank" rel="noreferrer noopener">{% endif %}<img src="{{ f.bild }}" alt="{{ f.bild_alt }}" style="aspect-ratio:1;object-fit:cover{% if f.bild_position %};object-position:{{ f.bild_position }}{% endif %}" />{% if f.bild_url %}</a>{% endif %}</figure>
<div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex">
<div class="wp-block-button"><a class="wp-block-button__link has-accent-3-background-color has-background wp-element-button" href="{{ f.url }}"{% if f.url | extern %} target="_blank" rel="noreferrer noopener"{% endif %}>{{ f.text }}</a></div>
</div>
{%- if not loop.last %}
<div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div>
{%- endif %}
{%- endfor %}
</div>
{%- endfor %}
</div>
<div style="height:50px" aria-hidden="true" class="wp-block-spacer"></div>

{%- for b in wissenspool.bereiche %}
{%- set farbig = loop.index0 % 2 == 0 %}
<div class="wp-block-group alignfull {{ 'has-accent-2-background-color' if farbig else 'has-base-background-color' }} has-background has-global-padding {{ bereich }}" style="{{ abstand }}">
<h2 class="wp-block-heading {{ 'has-text-align-right ' if farbig }}alignwide">{{ b.titel }}</h2>
<div class="wp-block-columns alignwide {{ spalten | replace('wp-block-columns ', '') }}">
{%- if not farbig %}
<div class="{{ spalte }}" style="flex-basis:40%"></div>
{%- endif %}
<div class="{{ spalte }}" style="flex-basis:60%">
{%- for e in b.eintraege %}
{{ eintrag(e) }}
{%- endfor %}
{%- for g in b.gruppen %}
<h{{ g.ebene or 4 }} class="wp-block-heading">{% if (g.ebene or 4) == 4 %}<strong>{{ g.titel }}</strong>{% else %}{{ g.titel }}{% endif %}</h{{ g.ebene or 4 }}>
{%- for e in g.eintraege %}
{{ eintrag(e) }}
{%- endfor %}
{%- endfor %}
</div>
{%- if farbig %}
<div class="{{ spalte }}" style="flex-basis:40%"></div>
{%- endif %}
</div>
{%- if b.bild %}
<div style="height:30px" aria-hidden="true" class="wp-block-spacer"></div>
<figure class="wp-block-image aligncenter size-full is-style-rounded ki-abgerundet"><img src="{{ b.bild }}" alt="{{ b.bild_alt }}" style="aspect-ratio:16/9;object-fit:cover" /></figure>
{%- endif %}
</div>
{%- endfor %}
