{#- Dauerhafte Angebote (ohne festen Termin) auf /workshops/. Daten: src/_data/termine.yaml -#}
{%- set spalte = "wp-block-column is-layout-flow wp-block-column-is-layout-flow" -%}
{% for d in termine.dauerangebote %}
<hr class="wp-block-separator has-alpha-channel-opacity{{ ' is-style-default' if not loop.first }}"/>
<div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-3a88641f wp-block-columns-is-layout-flex">
<div class="{{ spalte }}" style="flex-basis:33.33%">
<h3 class="wp-block-heading">{{ d.rubrik }}</h3>
</div>
<div class="{{ spalte }}" style="flex-basis:66.66%">
<p class="wp-block-paragraph">{% if d.hinweis %}<em>{{ d.hinweis }}</em><br>{% endif %}<a href="{{ d.url }}" target="_blank" rel="noreferrer noopener"><strong>{{ d.titel }}</strong></a></p>
<p class="wp-block-paragraph">{% if d.mit %}<em>mit {{ d.mit }}</em><br>{% endif %}{{ d.beschreibung | trim | escape | replace("\n", "<br>") | safe }}<br><a href="{{ d.url }}" target="_blank" rel="noreferrer noopener">Mehr Infos</a></p>
</div>
</div>
{% endfor %}
<hr class="wp-block-separator has-alpha-channel-opacity is-style-default"/>
